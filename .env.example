AI_PROVIDER=local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# AI_PROVIDER=gemini (or `npm run api:gemini`) uses Google instead. Free key: https://aistudio.google.com/apikey
# Free tier: Google may use what is sent (site photos, plans, questions) to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Postgres: a long random value. Generate one and add it to .env with:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# docker compose uses it to create the database on first start; do not change it afterwards.
# No openssl? Any long mix of letters and numbers works (no @ : / symbols).
POSTGRES_PASSWORD=
# for `npm run api` / tests outside Docker (docker compose publishes Postgres on 127.0.0.1:5432 only)
DATABASE_URL=postgres://sitesight:<POSTGRES_PASSWORD>@localhost:5432/sitesight
# optional: people must enter this code to create an account
SIGNUP_CODE=
# only if a proxy other than the included Caddy serves https (Caddy already marks cookies Secure)
COOKIE_SECURE=

# ---- Oracle VM (docker-compose.prod.yml), see DEPLOY.md
# the site's domain; Caddy gets a free https certificate for it. No domain? <name>.<ip-with-dashes>.sslip.io
SITE_ADDRESS=
# time zone for "today" / "this week" in reports and chat
TZ=Asia/Kolkata

# ---- WhatsApp Cloud API (see SITESIGHT_PLAN 5.9c); nothing is sent while WHATSAPP_TOKEN is empty
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
PUBLIC_URL=
